rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read-only collection (optional)
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Per-user private data. Clients can't set isAdmin on their user document;
    // only the Admin SDK (which bypasses rules) can.
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && !('isAdmin' in request.resource.data);

      // {document=**} alone would also match users/{userId} and skip the check above.
      match /{subcollection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
